 .hs-z b{font-size:inherit}
-.zmena-box{background:#FFF6CC;border-left:4px solid var(--accent);border-radius:8px;padding:10px 14px;font-size:15px}
+.zmena-box{background:#F1F7D2;border-left:4px solid var(--accent);border-radius:8px;padding:10px 14px;font-size:15px}
