 *{box-sizing:border-box}
 html{scroll-behavior:smooth;scroll-padding-top:90px}
 body{margin:0;background:var(--ground);color:var(--ink);font-family:Barlow,"Segoe UI",system-ui,sans-serif;font-size:18px;line-height:1.55}
@@ -35,7 +35,11 @@ a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid var
 header.top{position:sticky;top:0;z-index:10;background:var(--dark);border-bottom:4px solid var(--accent)}
 header.top .wrap{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding-top:14px;padding-bottom:14px}
 .logo{display:flex;align-items:center;gap:12px;text-decoration:none;color:#fff}.logo:hover{color:#fff}
-.logo span{font-family:"Barlow Condensed",sans-serif;font-weight:800;font-size:26px;letter-spacing:.5px;text-transform:uppercase}
+/* logo: na počítači visí cez spodný okraj lišty, po odscrollovaní sa zmenší */
+.logo{position:relative;flex:none;width:99px;height:44px}
+.logo img{position:absolute;left:0;top:-6px;width:auto;height:104px;filter:drop-shadow(0 4px 6px rgba(0,0,0,.35));transition:height .2s ease,top .2s ease}
+header.top.mini .logo{width:53px}
+header.top.mini .logo img{height:56px;top:-6px;filter:none}
 nav.menu{display:flex;flex-wrap:wrap;align-items:center;gap:6px 18px;font-weight:600;font-size:16px}
 nav.menu a.n{color:#fff;text-decoration:none;padding:10px 0;border-bottom:2px solid transparent}
 nav.menu a.n:hover{color:var(--accent)}
@@ -116,7 +120,8 @@ footer.foot a{color:#fff}
 .mbar{display:none}
